# ---------------------------------------------------------------------------
# 复制本文件为 .env 后填写。docker compose 会自动读取同目录下的 .env
# ---------------------------------------------------------------------------

# 服务器公网 IP 或域名。团队成员的客户端通过它连接中继。
# 已经写死在客户端里了（build/custom.toml 的 relay_host）：
# 客户端会连 wedesk.alsoapp.com:5188。改这里之前请先确认那边的配置同步改了。
RELAY_HOST=wedesk.alsoapp.com

# 是否强制走中继。N = 优先 P2P 直连（省带宽，推荐内网/团队同网场景）
# Y = 全部走服务器中转（连通率高，消耗服务器带宽）
ALWAYS_USE_RELAY=N

# 日志级别：error / warn / info / debug / trace
# 默认 warn：info 级别下每次注册/心跳都落一行，长期运行的磁盘写入可观。
# 排障时临时改成 info 或 debug 即可，不需要改 compose 文件。
RUST_LOG=warn

# # 【服务端镜像】默认是本地 Dockerfile 编译出来的 wedesk-server:latest。
# 这一行保持注释 = 用本地构建的镜像。
#
# 想直接用 CI 推到 Docker Hub 的镜像，取消下面这行的注释：
#RD_IMAGE=liaozhiming/wedesk-server:latest
#
# 改回官方镜像（**会失去本地化补丁**，且不是你自己编译的）：
#   RD_IMAGE=rustdesk/rustdesk-server:latest

# ---------------------------------------------------------------------------
# 端口规划
# ---------------------------------------------------------------------------
# 端口不是随便排的，是从【主端口】推导出来的，改之前先看 docs/10-ports.md：
#
#   hbbs 主端口 P=5187  →  TCP P-1(5186) NAT 探测
#                          TCP+UDP P(5187)   注册 / 心跳 / TCP 打洞
#                          TCP P+2(5189) WebSocket（进程必监听，我们不对外开）
#   hbbr 主端口 R=5188  →  TCP R(5188)       中继数据
#                          TCP R+2(5190) WebSocket（同上，不对外开）
#
# 因此这三个变量必须满足：HBBS_NAT_PORT = HBBS_PORT - 1
# （rdctl.py start 会校验，不满足直接报错退出，宁可不启动也不要半通的配置）
#
# 一般无需修改。只有宿主这几个端口已被占用时才平移——平移请【整体移动】：
# 把三个值一起改掉，并重新核查 P+2 / R+2 没有撞到别的服务。
HBBS_PORT=5187          # hbbs 主端口，同时传给 `hbbs -p`
HBBS_NAT_PORT=5186      # = HBBS_PORT - 1
HBBR_PORT=5188          # hbbr 主端口，同时传给 `hbbr -p`，也是客户端被告知的中继端口

# hbbs / hbbr 的 WebSocket 端口 5189 / 5190 刻意不在 compose 里 publish：
# 它们的分支会无条件信任 X-Real-IP / X-Forwarded-For，任何人直连都能伪造来源 IP。
# 详见 docker-compose.yml 里的说明与 docs/10-ports.md。

# ---------------------------------------------------------------------------
# 资源上限。默认值按 50 人以内团队给出，一般不用动。
# 只有观察到容器被 OOM 重启、或团队规模上到数百人时才需要调。
# ---------------------------------------------------------------------------
# hbbs 只做注册与打洞协调，不转发画面，实测常驻 10-40 MB
HBBS_MEM=256m
HBBS_CPUS=0.50
# hbbr 转发画面，占用随并发路数增长；真正的瓶颈通常是带宽而非内存
HBBR_MEM=512m
HBBR_CPUS=1.00

# 容器日志轮转：单个文件上限 + 保留份数，防止长期运行把磁盘写满
LOG_MAX_SIZE=10m
LOG_MAX_FILE=3

# ---------------------------------------------------------------------------
# 数据库后端（默认 PostgreSQL）
# ---------------------------------------------------------------------------
# 服务端【除客户端外】的持久化数据全部落在 Postgres 里，一共三张表：
#   peer             ID / 设备台账（ID、uuid、公钥、备注、注册信息、状态）
#   server_config    服务端自身状态，目前托管 id_ed25519 密钥对
#   connection_log   连接审计（谁连了谁、时间、走中继还是 P2P）
#
# 默认一套就能跑：compose 会连带拉起 rd-postgres 容器，数据落在 ./pgdata。
# 需要三处保持一致（缺一个就会静默退化，务必跑 doctor 验证）：
#   DB_TYPE=postgres
#   DB_URL=postgres://<PG_USER>:<PG_PASSWORD>@postgres:5432/<PG_DB>
#   PG_PASSWORD=<与 DB_URL 里同一个口令>
#
# ⚠️ 主机名必须是 postgres（compose 的【服务名】），不要写成 rd-postgres ——
#    那是容器名，compose 网络里也能解析，但 rdrun.sh 那条路线用的是容器名。
#
# ⚠️ 官方 rustdesk/rustdesk-server 镜像【不认 DB_TYPE 也没有后两张表】，
#    配了不会报错，只是悄悄继续写 SQLite。RD_IMAGE 必须指向本仓库编的镜像。
#    改完务必跑一次：python rdctl.py doctor   ← 它会告诉你数据实际落在哪
DB_TYPE=postgres
DB_URL=postgres://rustdesk:changeme@postgres:5432/rustdesk

# --- 退回 SQLite（不推荐：会失去密钥托管与连接审计） ------------------------
# 只保留 peer 一张表，密钥落 ./data/id_ed25519，完全等同官方行为。
# 适用于单机、无需多实例、也不关心审计的场景。
#DB_TYPE=sqlite
#DB_URL=/root/db_v2.sqlite3

# PostgreSQL 服务参数
PG_IMAGE=postgres:16-alpine
PG_DB=rustdesk
PG_USER=rustdesk
PG_PASSWORD=changeme        # 生产必须改掉：私钥也托管在这个库里
PG_MEM=512m
PG_CPUS=1.00

# DB_URL 省略时的推导来源（默认 postgres:5432，即 compose 里的服务名）。
# 接外部/托管 Postgres 时直接写完整 DB_URL 即可，不必动这两个：
#PG_HOST=postgres
#PG_PORT=5432

# --- 密钥托管 -------------------------------------------------------------
# 默认开：私钥存进 server_config 表，多台 hbbs 读同一行 → 共享同一套 ID。
# 设为 N 则退回"只用本地文件"的上游行为（多实例下每台各生成一把钥匙）。
#DB_STORE_KEY=Y

# --- 连接审计 -------------------------------------------------------------
# 默认开：热路径只往内存缓冲 push，后台任务每 AUDIT_FLUSH_SECS 秒批量落库。
# AUDIT_LOG=N        完全关闭（连缓冲都不进，热路径零开销）
# AUDIT_FLUSH_SECS=5 刷盘间隔（秒）
# AUDIT_MAX_BUFFER=20000  缓冲上限，数据库长时间不可用时防止内存无限增长
#AUDIT_LOG=Y
#AUDIT_FLUSH_SECS=5
#AUDIT_MAX_BUFFER=20000

# 连接池大小。**默认留空**：留空则两个后端各用自己的合理默认值
#   sqlite → 1（写串行，连接多了只会更容易撞 database is locked）
#   postgres → 8
# 这里一旦写死，默认的 SQLite 路径也会被迫用它，偏离上游行为。
#MAX_DATABASE_CONNECTIONS=8

# PostgreSQL 首次连接失败后的重试次数（每次间隔 3 秒，默认 10 次 ≈ 30 秒）。
# 只对 DB_TYPE=postgres 生效。容器并发启动时 hbbs 常常先于 Postgres 可用，
# 不重试就会直接退出进入 CrashLoop，日志里只有一行看不懂的连接错误。
# 想保留"连不上立刻失败、由编排器重启"的行为，设成 1。
#DB_CONNECT_RETRIES=10
