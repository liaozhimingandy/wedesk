# ---------------------------------------------------------------------------
# 复制本文件为 .env 后填写。docker compose 会自动读取同目录下的 .env
# ---------------------------------------------------------------------------

# 服务器公网 IP 或域名。团队成员的客户端通过它连接中继。
# 局域网测试时填本机局域网 IP，例如 192.168.1.50
RELAY_HOST=127.0.0.1

# 是否强制走中继。N = 优先 P2P 直连（省带宽，推荐内网/团队同网场景）
# Y = 全部走服务器中转（连通率高，消耗服务器带宽）
ALWAYS_USE_RELAY=N

# 日志级别：error / warn / info / debug / trace
RUST_LOG=info

# 服务端镜像。固定版本号可避免上游更新导致的不兼容，生产建议锁版本
# 例：rustdesk/rustdesk-server:1.1.14
RD_IMAGE=rustdesk/rustdesk-server:latest

# 端口映射（一般无需修改，除非主机端口冲突）
HBBS_TCP=21115
HBBS_UDP=21116
HBBS_TCP_HP=21116
HBBR_TCP=21117
RELAY_PORT=21117
