# 统一换行符策略，避免 Windows 检出时 core.autocrlf 制造整文件 diff 噪声。
# 规则：脚本与配置文件一律 LF；Windows 批处理脚本必须 CRLF 才能正常解析。

* text=auto

*.py            text eol=lf
*.toml          text eol=lf
*.md            text eol=lf
*.yml           text eol=lf
*.yaml          text eol=lf
.gitignore      text eol=lf
.gitattributes  text eol=lf

# docker compose 读 .env 时不会吃掉行尾的 \r，值会变成 "192.168.1.50\r"，
# 表现为 RELAY_HOST 看起来填对了却连不上。这类文件必须钉死为 LF。
.env            text eol=lf
.env.example    text eol=lf
*.env           text eol=lf
*.sh            text eol=lf

# Windows 批处理对换行敏感，CMD 在部分语法下无法正确处理纯 LF
*.bat           text eol=crlf
*.cmd           text eol=crlf

*.patch        text eol=lf
*.json        text eol=lf

# 二进制资源不做换行转换
*.png           binary
*.ico           binary
*.zip           binary
