# ---------------------------------------------------------------------------
# 复制本文件为 .env 后填写。docker compose 会自动读取同目录下的 .env
# ---------------------------------------------------------------------------

# 服务器公网 IP 或域名。团队成员的客户端通过它连接中继。
# 已经写死在客户端里了（build/custom.toml 的 relay_host）：
# 客户端会连 wedesk.alsoapp.com:5188。改这里之前请先确认那边的配置同步改了。
RELAY_HOST=wedesk.alsoapp.com

# 是否强制走中继。N = 优先 P2P 直连（省带宽，推荐内网/团队同网场景）
# Y = 全部走服务器中转（连通率高，消耗服务器带宽）
ALWAYS_USE_RELAY=N

# 日志级别：error / warn / info / debug / trace
# 默认 warn：info 级别下每次注册/心跳都落一行，长期运行的磁盘写入可观。
# 排障时临时改成 info 或 debug 即可，不需要改 compose 文件。
RUST_LOG=warn

# # 服务端镜像。默认是本地 Dockerfile 编译出来的 wedesk-server；
# .env 里填了 RD_IMAGE 就以它为准（例如 CI 推到 GHCR 的版本）。
# 改回官方镜像：RD_IMAGE=rustdesk/rustdesk-server:latest（会失去本地化补丁）。
#RD_IMAGE=wedesk-server:latest

# ---------------------------------------------------------------------------
# 端口规划
# ---------------------------------------------------------------------------
# 端口不是随便排的，是从【主端口】推导出来的，改之前先看 docs/10-ports.md：
#
#   hbbs 主端口 P=5187  →  TCP P-1(5186) NAT 探测
#                          TCP+UDP P(5187)   注册 / 心跳 / TCP 打洞
#                          TCP P+2(5189) WebSocket（进程必监听，我们不对外开）
#   hbbr 主端口 R=5188  →  TCP R(5188)       中继数据
#                          TCP R+2(5190) WebSocket（同上，不对外开）
#
# 因此这三个变量必须满足：HBBS_NAT_PORT = HBBS_PORT - 1
# （rdctl.py start 会校验，不满足直接报错退出，宁可不启动也不要半通的配置）
#
# 一般无需修改。只有宿主这几个端口已被占用时才平移——平移请【整体移动】：
# 把三个值一起改掉，并重新核查 P+2 / R+2 没有撞到别的服务。
HBBS_PORT=5187          # hbbs 主端口，同时传给 `hbbs -p`
HBBS_NAT_PORT=5186      # = HBBS_PORT - 1
HBBR_PORT=5188          # hbbr 主端口，同时传给 `hbbr -p`，也是客户端被告知的中继端口

# hbbs / hbbr 的 WebSocket 端口 5189 / 5190 刻意不在 compose 里 publish：
# 它们的分支会无条件信任 X-Real-IP / X-Forwarded-For，任何人直连都能伪造来源 IP。
# 详见 docker-compose.yml 里的说明与 docs/10-ports.md。

# ---------------------------------------------------------------------------
# 资源上限。默认值按 50 人以内团队给出，一般不用动。
# 只有观察到容器被 OOM 重启、或团队规模上到数百人时才需要调。
# ---------------------------------------------------------------------------
# hbbs 只做注册与打洞协调，不转发画面，实测常驻 10-40 MB
HBBS_MEM=256m
HBBS_CPUS=0.50
# hbbr 转发画面，占用随并发路数增长；真正的瓶颈通常是带宽而非内存
HBBR_MEM=512m
HBBR_CPUS=1.00

# 容器日志轮转：单个文件上限 + 保留份数，防止长期运行把磁盘写满
LOG_MAX_SIZE=10m
LOG_MAX_FILE=3
