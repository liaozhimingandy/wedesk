# ---------------------------------------------------------------------------
# 复制本文件为 .env 后填写。docker compose 会自动读取同目录下的 .env
# ---------------------------------------------------------------------------

# 服务器公网 IP 或域名。团队成员的客户端通过它连接中继。
# 已经写死在客户端里了（build/custom.toml 的 relay_host）：
# 客户端会连 wedesk.alsoapp.com:5188。改这里之前请先确认那边的配置同步改了。
RELAY_HOST=wedesk.alsoapp.com

# 是否强制走中继。N = 优先 P2P 直连（省带宽，推荐内网/团队同网场景）
# Y = 全部走服务器中转（连通率高，消耗服务器带宽）
ALWAYS_USE_RELAY=N

# 日志级别：error / warn / info / debug / trace
# 默认 warn：info 级别下每次注册/心跳都落一行，长期运行的磁盘写入可观。
# 排障时临时改成 info 或 debug 即可，不需要改 compose 文件。
RUST_LOG=warn

# # 【服务端镜像】默认是本地 Dockerfile 编译出来的 wedesk-server:latest。
# 这一行保持注释 = 用本地构建的镜像。
#
# 想直接用 CI 推到 Docker Hub 的镜像，取消下面这行的注释：
#RD_IMAGE=liaozhiming/wedesk-server:latest
#
# 改回官方镜像（**会失去本地化补丁**，且不是你自己编译的）：
#   RD_IMAGE=rustdesk/rustdesk-server:latest

# ---------------------------------------------------------------------------
# 固定端口表
# ---------------------------------------------------------------------------
# 【默认一套端口是固定的，全部写死在 docker-compose.yml 里，不做任何 +1/+2 推导】
#
#   ┌──────┬────────┬──────┬────────────────────────────┬──────────────┐
#   │ 端口 │ 协议   │ 进程 │ 用途                       │ 对外？       │
#   ├──────┼────────┼──────┼────────────────────────────┼──────────────┤
#   │ 5186 │ TCP    │ hbbs │ NAT 类型探测               │ 必须         │
#   │ 5187 │ TCP    │ hbbs │ 注册 / TCP 打洞与连接      │ 必须         │
#   │ 5187 │ UDP    │ hbbs │ 注册 + 心跳 + UDP 打洞     │ 必须         │
#   │ 5188 │ TCP    │ hbbr │ 中继转发                   │ 必须         │
#   │ 5189 │ TCP    │ hbbs │ WebSocket 注册通道         │ 必须         │
#   │ 5190 │ TCP    │ hbbr │ WebSocket 中继             │ 必须         │
#   │ 5191 │ TCP    │ hbbs │ 健康检查 GET /health       │ 建议         │
#   │ 5192 │ TCP    │ hbbr │ 健康检查 GET /health       │ 建议         │
#   └──────┴────────┴──────┴────────────────────────────┴──────────────┘
#
#   5185 TCP 是客户端按 rendezvous 端口 -2 自己推导的 api-server，
#   hbbs 不监听它（那是官方 SaaS 才有的服务），不用放行、不用管。
#
# 【下面这几个变量只有 rdrun.sh / rdctl.py 会读，compose 不读】
# compose 用的是写死的数字；这里保留变量是为了让你在宿主端口冲突时
# 用 `rdrun.sh --hbbs-port ...` 之类的参数整体平移。
# 平移时五个值必须一起改，且满足源码硬编码的关系：
#       HBBS_NAT_PORT = HBBS_PORT - 1
#       HBBS_WS_PORT  = HBBS_PORT + 2
#       HBBR_WS_PORT  = HBBR_PORT + 2
# （rdctl.py / rdrun.sh 都会校验，不满足直接报错退出 —— 宁可不启动，
#   也不要一个"端口开着但连不上"的半通配置。）
HBBS_PORT=5187          # hbbs 主端口，同时传给 `hbbs -p`
HBBS_NAT_PORT=5186
HBBR_PORT=5188          # hbbr 主端口，同时传给 `hbbr -p`，也是客户端被告知的中继端口
HBBS_WS_PORT=5189
HBBR_WS_PORT=5190

# WebSocket 端口 5189 / 5190 必须对外：客户端 UDP 不通或勾了"使用 WebSocket"
# 时用它注册，摸不到就永远卡在"正在接入网络"。
# 若你在前面挂了反向代理，请让代理【覆写】X-Real-IP / X-Forwarded-For ——
# WS 分支会无条件信任这两个头，有代理时客户端可以伪造来源 IP。
# 做不到就把 docker-compose.yml 里那两条映射注释掉。详见 docs/10-ports.md。

# ---------------------------------------------------------------------------
# 资源上限。默认值按 50 人以内团队给出，一般不用动。
# 只有观察到容器被 OOM 重启、或团队规模上到数百人时才需要调。
# ---------------------------------------------------------------------------
# hbbs 只做注册与打洞协调，不转发画面，实测常驻 10-40 MB
HBBS_MEM=256m
HBBS_CPUS=0.50
# hbbr 转发画面，占用随并发路数增长；真正的瓶颈通常是带宽而非内存
HBBR_MEM=512m
HBBR_CPUS=1.00

# --- 健康检查 HTTP 端口（GET /health 返回 JSON 状态） ----------------------
# 固定值：hbbs 5191，hbbr 5192（compose 里已写死）。
# compose 已带 healthcheck（容器内 wget 自检），外部监控直接拨这两个端口：
#   curl http://<server>:5191/health
# rdrun.sh 平移端口时同步改这两个；设 0 关闭健康检查服务。
HBBS_HEALTH_PORT=5191
HBBR_HEALTH_PORT=5192

# 容器日志轮转：单个文件上限 + 保留份数，防止长期运行把磁盘写满
LOG_MAX_SIZE=10m
LOG_MAX_FILE=3

# ---------------------------------------------------------------------------
# 数据库后端（默认 PostgreSQL）
# ---------------------------------------------------------------------------
# 服务端【除客户端外】的持久化数据全部落在 Postgres 里，一共四张表：
#   peer               ID / 设备台账（ID、uuid、公钥、备注、注册信息、状态）
#   server_config      旧版密钥托管残留（新版本启动时自动迁出并清空，不再存密钥）
#   connection_log     连接审计（谁连了谁、时间、走中继还是 P2P）
#   relay_nodes        中继节点登记与实时健康（区域 / 权重 / 容量 / 时延）
#   relay_access_list  hbbr 的黑名单与阻断名单（hbbr 单独连库读写这一张）
#
# ⚠️ 注意最后一张：hbbr（中继）也会连这个库，但**只为读写名单**，
#    不碰 ID 台账与审计表。没配 DB_TYPE/DB_URL 时它退回 blacklist.txt /
#    blocklist.txt 文件模式（运行期改动也会写回文件），功能不缺失，
#    只是多台中继之间不会自动同步。
#
# 默认一套就能跑：compose 会连带拉起 rd-postgres 容器，数据落在 ./pgdata。
# 需要三处保持一致（缺一个就会静默退化，务必跑 doctor 验证）：
#   DB_TYPE=postgres
#   DB_URL=postgres://<PG_USER>:<PG_PASSWORD>@postgres:5432/<PG_DB>
#   PG_PASSWORD=<与 DB_URL 里同一个口令>
#
# ⚠️ 主机名必须是 postgres（compose 的【服务名】），不要写成 rd-postgres ——
#    那是容器名，compose 网络里也能解析，但 rdrun.sh 那条路线用的是容器名。
#
# ⚠️ 官方 rustdesk/rustdesk-server 镜像【不认 DB_TYPE 也没有后两张表】，
#    配了不会报错，只是悄悄继续写 SQLite。RD_IMAGE 必须指向本仓库编的镜像。
#    改完务必跑一次：python rdctl.py doctor   ← 它会告诉你数据实际落在哪
DB_TYPE=postgres
DB_URL=postgres://rustdesk:changeme@postgres:5432/rustdesk

# --- 退回 SQLite（不推荐：会失去连接审计） --------------------------------
# 只保留 peer 一张表，密钥落 ./data/id_ed25519，完全等同官方行为。
# 适用于单机、无需多实例、也不关心审计的场景。
#DB_TYPE=sqlite
#DB_URL=/root/db_v2.sqlite3

# PostgreSQL 服务参数
PG_IMAGE=postgres:16-alpine
PG_DB=rustdesk
PG_USER=rustdesk
PG_PASSWORD=changeme        # 生产必须改掉；库中已不存密钥，但仍属敏感凭据
PG_MEM=512m
PG_CPUS=1.00

# DB_URL 省略时的推导来源（默认 postgres:5432，即 compose 里的服务名）。
# 接外部/托管 Postgres 时直接写完整 DB_URL 即可，不必动这两个：
#PG_HOST=postgres
#PG_PORT=5432

# --- hbbr 名单持久化 ------------------------------------------------------
# 名单从数据库重载的间隔（秒）。设 0 = 只在启动时读一次。
# 多台中继同时跑时靠它收敛到同一份名单，所以别设太大。
ACCESS_RELOAD_SECS=60
# hbbr 连库失败的重试次数（默认 1 = 立刻退回文件模式）。
# 中继的可用性优先于名单持久化，这里刻意不同于 hbbs 的 10 次重试。
#HBBR_DB_RETRIES=1

# --- 密钥（2026-10-20 起只存文件，不进数据库） ------------------------------
# 私钥解析顺序：KEY_FILE → /run/secrets/id_ed25519（docker secrets 标准挂载）
#              → ./data/id_ed25519（工作目录，首次启动自动生成）
# 多实例共享同一套 ID：所有实例挂载同一个私钥文件。
# 推荐的 docker secrets 挂载（见 docker-compose.yml volumes 注释）：
#   -v /d/Git/secrets/id_ed25519:/run/secrets/id_ed25519:ro
# 或用 KEY_FILE 显式指定任意路径（容器内路径）：
#KEY_FILE=/run/secrets/id_ed25519

# --- 连接审计 -------------------------------------------------------------
# 默认开：热路径只往内存缓冲 push，后台任务每 AUDIT_FLUSH_SECS 秒批量落库。
# AUDIT_LOG=N        完全关闭（连缓冲都不进，热路径零开销）
# AUDIT_FLUSH_SECS=5 刷盘间隔（秒）
# AUDIT_MAX_BUFFER=20000  缓冲上限，数据库长时间不可用时防止内存无限增长
#AUDIT_LOG=Y
#AUDIT_FLUSH_SECS=5
#AUDIT_MAX_BUFFER=20000

# 连接池大小。**默认留空**：留空则两个后端各用自己的合理默认值
#   sqlite → 1（写串行，连接多了只会更容易撞 database is locked）
#   postgres → 8
# 这里一旦写死，默认的 SQLite 路径也会被迫用它，偏离上游行为。
#MAX_DATABASE_CONNECTIONS=8

# PostgreSQL 首次连接失败后的重试次数（每次间隔 3 秒，默认 10 次 ≈ 30 秒）。
# 只对 DB_TYPE=postgres 生效。容器并发启动时 hbbs 常常先于 Postgres 可用，
# 不重试就会直接退出进入 CrashLoop，日志里只有一行看不懂的连接错误。
# 想保留"连不上立刻失败、由编排器重启"的行为，设成 1。
#DB_CONNECT_RETRIES=10
