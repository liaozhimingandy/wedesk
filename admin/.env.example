# ---- PostgreSQL (reuses the SAME database as the wedesk hbbs) ----
PG_HOST=postgres
PG_PORT=5432
PG_USER=rustdesk
PG_PASSWORD=changeme
PG_DB=rustdesk
# Optionally override with a full URL (takes precedence over the PG_* fields):
# DATABASE_URL=postgres://rustdesk:changeme@postgres:5432/rustdesk

# ---- Service ----
ADMIN_HOST=0.0.0.0
ADMIN_PORT=5185
# CORS: comma separated origins, or * for all
CORS_ORIGINS=*

# ---- First admin bootstrap (auto-created on startup if no users exist) ----
DEFAULT_ADMIN_NAME=admin
DEFAULT_ADMIN_PASSWORD=changeme
DEFAULT_ADMIN_EMAIL=admin@wedesk.local

# ---- Session recording upload directory ----
RECORD_DIR=/data/records

# ---- PKI (ROOT -> CA -> device/app certificate). See docs/16-device-pki.md ----
# MUST be persistent: losing it means a brand new CA and every device must be
# re-activated. Files already present in PKI_DIR are used as-is and are NEVER
# overwritten -- put your own ROOT/CA there to take over.
PKI_DIR=/data/pki

# Bring your own ROOT/CA (production). Point at absolute paths, or just drop
# root.crt / ca.crt / ca.key into PKI_DIR. An offline ROOT needs only the
# certificate; the CA needs its private key because it signs every device cert.
# PKI_ROOT_CERT_FILE=/etc/wedesk/root.crt
# PKI_CA_CERT_FILE=/etc/wedesk/ca.crt
# PKI_CA_KEY_FILE=/run/secrets/ca.key
# PKI_ROOT_KEY_FILE=            # leave empty for an offline ROOT
# PKI_KEY_PASSWORD=              # only if the private keys are encrypted

# 0 = refuse to start when material is missing instead of generating a
# throwaway CA. Set this in production.
PKI_AUTO_CREATE=1
# 1 = allow a CA that is not signed by the supplied ROOT (default: reject)
PKI_ALLOW_UNCHAINED_CA=0

# Reverse proxy client-certificate headers (nginx defaults shown).
# PKI_MTLS_HEADER_CERT=X-SSL-Client-Cert
# PKI_MTLS_HEADER_VERIFY=X-SSL-Client-Verify

# ---- OIDC (optional). Leave OIDC_ISSUER empty to disable. ----
OIDC_ISSUER=
OIDC_CLIENT_ID=
OIDC_CLIENT_SECRET=
OIDC_REDIRECT_URI=http://localhost:5185/api/oidc/callback
