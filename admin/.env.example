# ---- PostgreSQL (reuses the SAME database as the wedesk hbbs) ----
PG_HOST=postgres
PG_PORT=5432
PG_USER=rustdesk
PG_PASSWORD=changeme
PG_DB=rustdesk
# Optionally override with a full URL (takes precedence over the PG_* fields):
# DATABASE_URL=postgres://rustdesk:changeme@postgres:5432/rustdesk

# ---- Service ----
ADMIN_HOST=0.0.0.0
ADMIN_PORT=5185
# CORS: comma separated origins, or * for all
CORS_ORIGINS=*

# ---- First admin bootstrap (auto-created on startup if no users exist) ----
DEFAULT_ADMIN_NAME=admin
DEFAULT_ADMIN_PASSWORD=changeme
DEFAULT_ADMIN_EMAIL=admin@wedesk.local

# ---- Session recording upload directory ----
RECORD_DIR=/data/records

# ---- OIDC (optional). Leave OIDC_ISSUER empty to disable. ----
OIDC_ISSUER=
OIDC_CLIENT_ID=
OIDC_CLIENT_SECRET=
OIDC_REDIRECT_URI=http://localhost:5185/api/oidc/callback
